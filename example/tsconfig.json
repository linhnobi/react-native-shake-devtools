{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [],
    "paths": {
      "react-native-shake-devtools": ["../src/index.ts"],
      "react-native-shake-devtools/shake": ["../src/shake/index.ts"],
      "react-native-shake-devtools/capture": ["../src/capture/index.ts"],
