{
  "name": "react-native-shake-devtools",
  "version": "0.0.1",
  "description": "Open-source in-app bug reporting & devtools for React Native test builds: shake → prefilled bug report → Jira / Slack / Lark / webhook. Logs, network (redacted), crashes, steps. Stripped from prod.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linhnobi/react-native-shake-devtools.git"
  },
  "bugs": {
    "url": "https://github.com/linhnobi/react-native-shake-devtools/issues"
  },
  "homepage": "https://github.com/linhnobi/react-native-shake-devtools#readme",
  "keywords": [
    "react-native",
    "devtools",
    "debugging",
    "bug-report",
    "qa",
    "jira",
    "slack",
    "lark",
    "network-logger",
    "shake",
    "new-architecture",
    "expo",
    "debugger",
    "in-app-debugger",
    "network-inspector",
    "console-logger",
    "logger",
    "curl",
    "crash-log",
    "redaction",
    "bug-reporting",
    "shake-to-report",
    "qa-testing",
    "feedback"
  ],
  "private": true,
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    },
    "./shake": {
      "types": "./lib/typescript/shake/index.d.ts",
      "react-native": "./src/shake/index.ts",
      "default": "./lib/module/shake/index.js"
    },
    "./capture": {
      "types": "./lib/typescript/capture/index.d.ts",
      "react-native": "./src/capture/index.ts",
      "default": "./lib/module/capture/index.js"
    },
    "./i18n": {
      "types": "./lib/typescript/i18n/index.d.ts",
      "react-native": "./src/i18n/index.ts",
      "default": "./lib/module/i18n/index.js"
    },
    "./plain": {
      "types": "./lib/typescript/plain/index.d.ts",
      "react-native": "./src/plain/index.ts",
      "default": "./lib/module/plain/index.js"
    },
    "./noop": {
      "types": "./lib/typescript/noop/index.d.ts",
      "react-native": "./src/noop/index.ts",
      "default": "./lib/module/noop/index.js"
    },
    "./noop/capture": {
      "types": "./lib/typescript/noop/capture.d.ts",
      "react-native": "./src/noop/capture.ts",
      "default": "./lib/module/noop/capture.js"
    },
    "./noop/shake": {
      "types": "./lib/typescript/noop/shake.d.ts",
      "react-native": "./src/noop/shake.ts",
      "default": "./lib/module/noop/shake.js"
    },
    "./noop/i18n": {
      "types": "./lib/typescript/noop/i18n.d.ts",
      "react-native": "./src/noop/i18n.ts",
      "default": "./lib/module/noop/i18n.js"
    },
    "./noop/plain": {
      "types": "./lib/typescript/noop/plain.d.ts",
      "react-native": "./src/noop/plain.ts",
      "default": "./lib/module/noop/plain.js"
    },
    "./metro": {
      "types": "./src/metro/noop-resolver.d.ts",
      "default": "./src/metro/noop-resolver.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!src/testing",
    "!src/test-setup.ts",
    "README*",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "test": "jest",
    "test:ci": "jest --ci",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dom.json",
    "check": "npm run typecheck && npm run test:ci",
    "check:consumer": "node scripts/check-consumer.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13 || >=24.3"
  },
  "peerDependencies": {
    "@gorhom/bottom-sheet": ">=5",
    "react": ">=18.2",
    "react-native": ">=0.76",
    "react-native-gesture-handler": ">=2.18",
    "react-native-reanimated": ">=3.16 || >=4",
    "react-native-safe-area-context": ">=4"
  },
  "peerDependenciesMeta": {
    "@gorhom/bottom-sheet": {
      "//": "Chỉ entry `.` chạm tới (qua `Sheet`). Entry `./plain` (sheet dựng bằng RN lõi), `./shake`, `./capture`, `./i18n` không cần package này.",
      "optional": true
    },
    "react-native-gesture-handler": {
      "//": "Chỉ entry `.` cần: gorhom dựng trên nó, và hàng nhật ký vuốt-để-chép dùng `ReanimatedSwipeable`. Entry `./plain` không cần (hàng không vuốt; chép qua cú giữ lâu).",
      "optional": true
    },
    "react-native-safe-area-context": {
      "//": "Cùng lý do với `@gorhom/bottom-sheet`: entry `./shake` không render gì. Entry `.` chỉ đọc inset để sheet chừa status bar / home indicator; app không có `SafeAreaProvider` thì inset coi là 0.",
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@changesets/cli": "~3.0.3",
    "@gorhom/bottom-sheet": "~5.2.14",
    "@react-native/babel-preset": "~0.86.0",
    "@react-native/jest-preset": "~0.86.0",
    "@testing-library/react-native": "~13.2.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "babel-jest": "~30.3.0",
    "jest": "~30.3.0",
    "react": "19.2.3",
    "react-native": "~0.86.0",
    "react-native-builder-bob": "~0.43.2",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-reanimated": "~4.5.3",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-worklets": "~0.11.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "{**/*.test.{ts,tsx},testing/**,test-setup.ts,metro/**}",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
